{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "cfg",
			"type": "pickString",
			"description": "Select build configuration",
			"options": [
				"Debug",
				"Release"
			],
			"default": "Release"
		}
	],
	"tasks": [
		{
			"label": "configure",
			"type": "process",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build_mingw_${input:cfg}",
				"-G",
				"MinGW Makefiles",
				"-DCMAKE_BUILD_TYPE=${input:cfg}",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
				"-DCMAKE_C_COMPILER=${config:mingwGcc}",
				"-DCMAKE_CXX_COMPILER=${config:mingwGxx}",
				"-DCMAKE_PREFIX_PATH=${config:mingwQtRoot}",
				"-DmingwOpenCvRoot=${config:mingwOpenCvRoot}",
				"-DqtBinDir=${config:mingwQtRoot}/bin"
			],
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_mingw_${input:cfg}",
				"-j"
			],
			"dependsOn": [
				"configure"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "install",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--install",
				"build_mingw_${input:cfg}",
				"--prefix",
				"build_mingw_${input:cfg}/dist"
			],
			"dependsOn": [
				"build"
			],
			"problemMatcher": []
		},
		{
			"label": "cpack",
			"type": "shell",
			"command": "cpack",
			"args": [
				"--config",
				"build_mingw_${input:cfg}/CPackConfig.cmake"
			],
			"dependsOn": [
				"install"
			],
			"problemMatcher": []
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"if exist \"build_mingw_${input:cfg}\" rmdir /s /q \"build_mingw_${input:cfg}\""
			],
			"problemMatcher": []
		},
		// ===== 固定 Debug / Release 任务（供 launch.json 使用，不弹选择） =====
		{
			"label": "configure (debug)",
			"type": "process",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build_mingw_debug",
				"-G",
				"MinGW Makefiles",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
				"-DCMAKE_C_COMPILER=${config:mingwGcc}",
				"-DCMAKE_CXX_COMPILER=${config:mingwGxx}",
				"-DCMAKE_PREFIX_PATH=${config:mingwQtRoot}",
				"-DmingwOpenCvRoot=${config:mingwOpenCvRoot}",
				"-DqtBinDir=${config:mingwQtRoot}/bin"
			],
			"problemMatcher": []
		},
		{
			"label": "build (debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_mingw_debug",
				"-j"
			],
			"dependsOn": [
				"configure (debug)"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "configure (release)",
			"type": "process",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build_mingw_release",
				"-G",
				"MinGW Makefiles",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
				"-DCMAKE_C_COMPILER=${config:mingwGcc}",
				"-DCMAKE_CXX_COMPILER=${config:mingwGxx}",
				"-DCMAKE_PREFIX_PATH=${config:mingwQtRoot}",
				"-DmingwOpenCvRoot=${config:mingwOpenCvRoot}",
				"-DqtBinDir=${config:mingwQtRoot}/bin"
			],
			"problemMatcher": []
		},
		{
			"label": "build (release)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_mingw_release",
				"-j"
			],
			"dependsOn": [
				"configure (release)"
			],
			"problemMatcher": [
				"$gcc"
			]
		}
	]
}